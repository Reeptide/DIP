# Copy to .env and adjust for your machine. Never commit .env.
#
# Two different Kafka addresses matter here:
#   - Inside docker-compose (master/worker/inference containers): kafka:9092
#   - From the host (bench/run_bench.py, a local python master.py, etc.): localhost:29092
# docker-compose.yml sets KAFKA_BROKER=kafka:9092 for its own services regardless
# of what's below - these values are for running things directly on the host.

# Kafka broker
KAFKA_BROKER=localhost:29092

# Redis (host port 6380 - 6379 is taken by another local project's Redis)
REDIS_HOST=localhost
REDIS_PORT=6380

# MinIO (S3-compatible blob store for tile bytes)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dipadmin
MINIO_SECRET_KEY=dipadmin123
MINIO_BUCKET=dip-tiles
MINIO_SECURE=false

# Kafka topic partition count - the parallelism ceiling. Must match what
# kafka-init created (see docker-compose.yml); changing this after topics
# exist requires deleting the kafka-data volume or repartitioning manually.
KAFKA_PARTITIONS=12

# Node identity - both fall back to the hostname if unset (see
# app/config.py), which is normally correct for scaled Compose replicas.
# Only set these explicitly for a manual, non-Compose run on the host.
# INSTANCE_ID=master-local
# WORKER_ID=worker-local
