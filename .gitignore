# Runtime artifacts - these are generated by the app, never commit them
uploads/*
results/*
!uploads/.gitkeep
!results/.gitkeep

# ONNX model weights - downloaded by scripts/download_model.py, not source.
# yolov8n.onnx is ~13MB, mobilenetv2 ~14MB - real binary weights don't
# belong in git any more than the uploads/results images did.
models/*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
